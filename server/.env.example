PORT=4000

# Supabase (anon key만 사용. service role 키는 서버에도 두지 않는다 — RLS가 그대로 적용됨)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Gemini
# 개발 중에는 MOCK_AI=true 로 두어 무료 한도를 아낀다. (실제 일기는 무료 티어에 넣지 않기)
MOCK_AI=true
GEMINI_API_KEY=
# 쉼표로 여러 개 적으면 앞에서부터 시도하고, 붐비거나(503) 없는 모델(404)이면 다음으로 넘어간다.
# 쓸 수 있는 모델 확인: npm run models / 연결 확인: npm run ai-test
GEMINI_MODEL=
AI_TIMEOUT_MS=8000
# 일기 초안이 검사(길이·물음표·문체·새 내용)에 떨어졌을 때 다시 시도하는 횟수. 429·네트워크 오류는 재시도하지 않는다.
# 초안은 다른 모델로 넘어가지 않고 GEMINI_MODEL의 첫 번째 모델만 쓴다.
AI_DRAFT_RETRIES=0

# 쉼표로 구분한 허용 Origin (Expo 웹 개발용). 비워 두면 CORS 헤더를 보내지 않음.
CORS_ORIGINS=http://localhost:8081
